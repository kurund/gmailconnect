<?xml version="1.0"?>
<extension key="gmailconnect" type="module">
  <file>gmailconnect</file>
  <name>gmailconnect</name>
  <description>Gmail Integration</description>
  <license>AGPL-3.0</license>
  <authors>
    <author>
      <name>Third Sector Design</name>
      <email>info@thirdsectordesign.org</email>
      <role>Maintainer</role>
    </author>
  </authors>
  <urls>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-09-14</releaseDate>
  <version>1.0.0</version>
  <develStage>alpha</develStage>
  <compatibility mode="semver">
    <ver>6.10</ver>
  </compatibility>
  <php_compatibility mode="list">
    <ver>8.0</ver>
    <ver>8.1</ver>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
  </php_compatibility>
  <smarty_compatibility mode="list">
    <ver>5</ver>
  </smarty_compatibility>
  <comments>This is a new, undeveloped module</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Gmailconnect</namespace>
    <format>25.10.2</format>
    <angularModule>crmGmailconnect</angularModule>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty@1.0.3</mixin>
  </mixins>
  <upgrader>CRM_Gmailconnect_Upgrader</upgrader>
</extension>
